[Unit]
Description=agent-u web terminal backend
After=network-online.target

[Service]
WorkingDirectory=%h/agent-u
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node %h/agent-u/server/pty.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
KillMode=mixed

[Install]
WantedBy=default.target
