[Unit]
Description=claude-ui web terminal backend
After=network-online.target

[Service]
WorkingDirectory=%h/claude-ui
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node %h/claude-ui/server/pty.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
KillMode=mixed

[Install]
WantedBy=default.target
